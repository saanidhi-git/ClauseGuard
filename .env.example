# Copy to .env and fill in. Everything works without these.

# optional LLM for nicer explanations and Q&A: groq or gemini
LLM_PROVIDER=
LLM_API_KEY=
# LLM_MODEL=llama-3.1-8b-instant

# load fine-tuned Legal-BERT from the Hugging Face Hub instead of backend/models/legalbert
# LEGALBERT_HUB_ID=your-username/clauseguard-legalbert-small

# set to 1 to skip Legal-BERT and MiniLM (faster start, baseline + TF-IDF retrieval only)
# DISABLE_TRANSFORMERS=0
